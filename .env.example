# Copy to .env and uncomment what you need. Every variable is optional.
# `npm run dev` loads .env into the app; `docker compose` uses it to fill in docker-compose.yml.

# SQLite database file for local development (default: ./data/invoices.db).
# The Docker image always uses /app/data/invoices.db on the `invoice-data` volume.
# DATABASE_PATH=./data/invoices.db

# Time zone used for "today" (default issue dates), e.g. Asia/Riyadh. Docker default: UTC.
# TZ=UTC

# Host port published by docker compose (bound to 127.0.0.1). Default: 3000.
# PORT=3000

# Optional HTTP Basic Auth, enabled only when BOTH are set.
# BASIC_AUTH_USER=
# BASIC_AUTH_PASSWORD=
